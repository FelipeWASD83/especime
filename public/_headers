# Cabeçalhos que a Cloudflare aplica a cada arquivo deste site.
# Este arquivo não é publicado como página: o Worker lê e aplica sozinho.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# fontes nunca mudam de conteúdo sem mudar de nome: guardadas por um ano
/fontes/*
  Cache-Control: public, max-age=31536000, immutable

# imagens mudam raramente: uma semana no aparelho de quem visitou
/img/*
  Cache-Control: public, max-age=604800
